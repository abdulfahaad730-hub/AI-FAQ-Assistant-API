# Server Configuration
PORT=5000
MONGODB_URI=mongodb://localhost:27017/patrician_hackathon

# AI FAQ Assistant Configuration
# If GEMINI_API_KEY is not provided, the backend operates in intelligent offline Mock/RAG mode.
# To connect live Gemini API: generate a key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Admin Authentication Token for FAQ Knowledge Base Management (POST/PUT/DELETE /api/faqs)
# Default fallback is 'Pcas@2026' to align with the website admin dashboard.
ADMIN_SECRET_TOKEN=Pcas@2026

# SMTP Email Configuration (Nodemailer)
# Configure these variables to enable live delivery of confirmation passes.
# If these variables are not defined, the backend operates in simulated email mode.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-institutional-email@gmail.com
SMTP_PASS=your-app-specific-password
EMAIL_FROM="INNOVATERS 2026 Organizing Committee" <noreply@patriciancollege.ac.in>
